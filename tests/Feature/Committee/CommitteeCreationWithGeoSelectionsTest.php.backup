     */
    private function seedGovernanceLevels(): void
    {
        \DB::table('governance_level_definitions')->insert([
            'tenant_id' => $this->organisation->id,
            'level' => 1,
            'committee_name' => 'Central',
            'committee_code' => 'CENTRAL',
            'geo_name' => 'Country',
            'geo_code' => 'COUNTRY',
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        \DB::table('governance_level_definitions')->insert([
            'tenant_id' => $this->organisation->id,
            'level' => 2,
            'committee_name' => 'Province',
            'committee_code' => 'PROVINCE',
            'geo_name' => 'Province',
            'geo_code' => 'PROVINCE',
            'created_at' => now(),
            'updated_at' => now(),
        ]);
    }

    /**
     * Seed geo administrative units for testing
     */
    private function seedGeoUnits(): void
    {
        \DB::table('geo_administrative_units')->insert([
            'country_code' => 'NP',
            'admin_level' => 0,
            'admin_type' => 'country',
            'parent_id' => null,
            'name' => 'Nepal',
            'code' => 'NP',
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        \DB::table('geo_administrative_units')->insert([
            'country_code' => 'NP',
            'admin_level' => 1,
            'admin_type' => 'province',
