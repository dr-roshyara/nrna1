namespace App\Contexts\ReferenceGeography\Infrastructure;

use Illuminate\Support\Facades\DB;

final class RogueChainedWriter
{
    public function closeQuietly(int $finding): void
    {
        DB::table('refgeo_publications')
            ->where('position', '>', 0)
            ->update(['notice_kind' => 'closure', 'concerns_position' => $finding]);
    }
}
