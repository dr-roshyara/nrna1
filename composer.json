{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.10",
        "laravel/tinker": "^2.10",
        "lcobucci/jwt": "^5.0",
        "league/csv": "^9.10",
        "league/flysystem-local": "^3.0",
        "maatwebsite/excel": "^3.1",
        "ramsey/uuid": "^4.7",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-query-builder": "^6.0",
        "tecnickcom/tc-lib-pdf": "^8.0",
        "tecnickcom/tcpdf": "^6.4",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "infection/infection": "^0.29.10",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.0",
        "nunomaduro/collision": "^8.0",
        "pdepend/pdepend": "^2.16",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "qossmic/deptrac-shim": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "EngineeringKnowledge\\": "scripts/lib/EngineeringKnowledge/"
        },
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/TenantHelper.php",
            "app/Helpers/ElectionAudit.php",
            "app/Helpers/tenant.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "test": [
            "@php artisan test",
            "bash scripts/enforce-tenantid.sh"
        ],
        "merge-gate": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/phpunit/phpunit/phpunit --testsuite=Architecture",
            "@php vendor/qossmic/deptrac-shim/deptrac analyse --no-progress",
            "@php vendor/phpstan/phpstan/phpstan analyse -c phpstan-greenfield.neon --no-progress --memory-limit=1G",
            "@php vendor/phpunit/phpunit/phpunit --testsuite=GreenfieldCore",
            "@php -r \"echo PHP_EOL.'MERGE GATE: PASS (Architecture fitness / Deptrac / greenfield PHPStan / widened regression)'.PHP_EOL;\""
        ],
        "quality-gate": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d zend_extension=php_xdebug-3.5.3-8.3-ts-vs16-x86_64.dll -d xdebug.mode=coverage vendor/phpunit/phpunit/phpunit --testsuite=GreenfieldCore --coverage-xml=build/coverage/coverage-xml --log-junit=build/coverage/junit.xml",
            "@php vendor/infection/infection/bin/infection --coverage=build/coverage --skip-initial-tests --threads=1 --no-interaction",
            "@php -r \"echo PHP_EOL.'QUALITY GATE: measured (non-blocking tier - A-3 ratchet policy; see infection-summary.txt)'.PHP_EOL;\""
        ],
        "metrics:collect": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pdepend --summary-xml=build/metrics/pdepend-summary.xml app",
            "@php scripts/metrics/metrics-report.php build/metrics/pdepend-summary.xml 10"
        ]
    },
    "scripts-descriptions": {
        "merge-gate": "BLOCKING tier (PB-007 IDD 2d): Architecture + Behaviour + Engineering gates, fail-fast, one PASS/FAIL. STABLE PUBLIC INTERFACE (ARB R3) - internals may change, the command contract must not.",
        "quality-gate": "NON-BLOCKING tier (PB-007 IDD 2d): Infection mutation measurement via pre-generated coverage (two-step: the platform owns PHPUnit execution semantics, not Infection). Measures and records; never blocks a merge (A-3).",
        "metrics:collect": "ADVISORY tier (metrics spike, plan 20260803-2130): pdepend over app/ -> top-N CBO warnings + append-only trend snapshot (engineering/verification/metrics/trend.jsonl). Observes and records; never blocks anything. ~7min runtime - on-demand, not a gate."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
