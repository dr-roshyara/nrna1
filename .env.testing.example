# .env.testing.example — copy to .env.testing and fill in the blanks.
# .env.testing is NOT tracked (it holds a real database password).
# Every key below is one the test runner or `artisan serve --env=testing` needs.

APP_ENV=testing
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nrna_test
DB_USERNAME=publicdigit_user
DB_PASSWORD=
APP_KEY=
MAIL_MAILER=log
MAX_USE_IP_ADDRESS=25
