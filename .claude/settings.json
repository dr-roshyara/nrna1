{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/db-safety-check.sh \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/project-knowledge-guard.sh \"$CLAUDE_TOOL_INPUT\"",
            "statusMessage": "Checking project-memory boundary"
          },
          {
            "type": "command",
            "command": "bash .claude/scripts/discipline-gate-reminder.sh \"$CLAUDE_TOOL_INPUT\""
          },
          {
            "type": "command",
            "command": "bash .claude/scripts/ddd-principles-reminder.sh \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-changes-logger.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/inject-context.sh",
            "statusMessage": "Loading project context (.claude/CONTEXT.md)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-log-reminder.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/dev-guide-reminder.sh"
          }
        ]
      }
    ]
  },
  "plansDirectory": "./.claude/plans",
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  }
}
